<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_cosmic_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Chat"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_chat_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session active"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_pop_out"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Pop Out"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_pill_glass_button"
            android:paddingHorizontal="16dp" />

        <!-- Audio call button -->
        <ImageButton
            android:id="@+id/btn_audio_call"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_glass_button"
            android:src="@android:drawable/ic_menu_call"
            android:tint="#FFFFFF"
            android:contentDescription="Audio call"
            android:padding="8dp" />

        <!-- Video call button -->
        <ImageButton
            android:id="@+id/btn_video_call"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_glass_button"
            android:src="@drawable/ic_camera"
            android:tint="#FFFFFF"
            android:contentDescription="Video call"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- Typing Indicator -->
    <TextView
        android:id="@+id/tv_chat_typing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_accent"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Reply Preview Bar -->
    <LinearLayout
        android:id="@+id/reply_preview_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#208B5CF6"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_reply_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_accent"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btn_cancel_reply"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_accent"
            android:contentDescription="Cancel reply" />
    </LinearLayout>

    <!-- Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill_glass_button"
            android:src="@android:drawable/ic_menu_add"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:contentDescription="Attach"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/et_chat_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input_pill"
            android:hint="Type a message…"
            android:textColor="#FFFFFF"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            android:paddingHorizontal="18dp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:gravity="center_vertical" />

        <!-- Voice message: hold to record -->
        <ImageButton
            android:id="@+id/btn_voice"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill_glass_button"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:contentDescription="Hold to record voice"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_send_chat"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:background="@drawable/bg_send_button_pill"
            android:paddingHorizontal="22dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
